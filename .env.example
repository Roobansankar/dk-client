VITE_API_URL=http://localhost:8000/api
# Canonical production origin used for canonical URLs, Open Graph, JSON-LD,
# robots.txt and sitemap.xml (defaults to https://dkstylehub.com).
VITE_SITE_URL=https://dkstylehub.com
# Google Analytics measurement id (Admin -> Data Streams -> your stream, in
# GA4). Only added to `npm run build` output, never to `npm run dev` — so
# local testing is never counted as site traffic. Leave empty to skip it.
VITE_GA_ID=G-6XXMCM410E
